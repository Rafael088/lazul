#!/usr/bin/env bash
# ./dev: único punto de entrada de Lazul. Salida breve: una línea por paso;
# si algo falla, lo esencial y la ruta del registro completo en .dev/.
#
#   ./dev check              formato, vet, compilar, pruebas, proto al día, tipos TS
#   ./dev test [paquetes]    pruebas de Go (por defecto ./...)
#   ./dev contrato           contrato de platform contra el adaptador de este sistema
#   ./dev sim [-receptores N] [-mdns]  controlador y N receptores: descubrir, emparejar, rechazar
#   ./dev replay [-v] [-barrer]  mide el clasificador (grabaciones reales y sintéticas)
#   ./dev grabar [-dir D]    página local para grabar gestos con la cámara
#   ./dev gen                regenera los tipos de Go y TS desde proto/
#   ./dev win test|contrato|check   lo mismo en el PC Windows por `ssh win`
#   ./dev e2e win|linux [args]  de punta a punta entre este Linux y el PC Windows
#   ./dev app [args]         la app de escritorio (prototipo) en este Linux
#   ./dev app win [args]     la compila, la copia al PC Windows y la abre en su escritorio
#   ./dev app resumen        activaciones de los últimos 30 min de uso (registro local)
#   ./dev app compilar       compila la app para Linux y Windows (sin abrirla)
#   ./dev app e2e win|linux  la app en los 2 PCs con grabaciones en vez de cámara
set -uo pipefail
cd "$(dirname "$0")"
RAIZ=$PWD
mkdir -p .dev
MOD=github.com/Rafael088/lazul

# paso NOMBRE comando...: corre en silencio; "ok" o el resumen del error.
paso() {
	local nombre=$1; shift
	local log=".dev/$nombre.log" ini=$SECONDS
	if "$@" >"$log" 2>&1; then
		printf 'ok     %-10s %ss\n' "$nombre" $((SECONDS - ini))
		return 0
	fi
	printf 'FALLA  %-10s (registro: %s)\n' "$nombre" "$log"
	resumen "$log"
	return 1
}

# resumen: solo las líneas que dicen qué falló.
resumen() {
	local lineas
	lineas=$(grep -E -- '--- FAIL|^FAIL|panic:|\.go:[0-9]+|error|Error|^[A-Za-z/._-]+\.go$|^diff|^[-+][^-+]' "$1" | grep -v '^ok ' | head -40)
	[ -n "$lineas" ] || lineas=$(tail -20 "$1")
	printf '%s\n' "$lineas" | sed 's/^/       /'
}

archivos_go() { git ls-files -co --exclude-standard '*.go' | grep -v '^prototipos/' | while read -r f; do [ -f "$f" ] && echo "$f"; done; }

fmt_check() {
	local mal
	mal=$(archivos_go | xargs gofmt -l)
	[ -z "$mal" ] || { echo "sin gofmt (corre gofmt -w):"; echo "$mal"; return 1; }
}

go_test() {
	local salida estado
	salida=$(go test "$@" 2>&1); estado=$?
	echo "$salida"
	echo "paquetes con pruebas: $(grep -c '^ok ' <<<"$salida")"
	return $estado
}

hay_protoc() { command -v protoc >/dev/null; }

# generar DESTINO: escribe los tipos en DESTINO/go y DESTINO/ts.
generar() {
	local dst=$1
	hay_protoc || { echo "falta protoc"; return 1; }
	[ -x proto/ts/node_modules/.bin/protoc-gen-es ] || (cd proto/ts && npm ci --silent --no-audit --no-fund) || return 1
	go build -o .dev/bin/protoc-gen-go google.golang.org/protobuf/cmd/protoc-gen-go || return 1
	mkdir -p "$dst/go" "$dst/ts"
	protoc -I proto \
		--plugin=protoc-gen-go=.dev/bin/protoc-gen-go --go_out="$dst/go" --go_opt=module=$MOD/proto/go \
		--plugin=protoc-gen-es=proto/ts/node_modules/.bin/protoc-gen-es --es_out="$dst/ts" --es_opt=target=ts,import_extension=ts \
		lazul/v1/lazul.proto
}

# La línea con la versión de protoc cambia entre máquinas; no cuenta.
sin_version() { grep -v -E '^//[[:space:]]+protoc[[:space:]]+v' "$1"; }

proto_al_dia() {
	local tmp=.dev/gen
	rm -rf "$tmp"
	generar "$tmp" || return 1
	local f d=0
	for f in go/lazulv1/lazul.pb.go ts/lazul/v1/lazul_pb.ts; do
		local destino=proto/${f/ts\//ts/src/}
		if ! diff -u <(sin_version "$destino") <(sin_version "$tmp/$f") >/dev/null 2>&1; then
			echo "$destino no coincide con proto/lazul/v1/lazul.proto: corre ./dev gen"
			d=1
		fi
	done
	return $d
}

cmd_gen() {
	local tmp=.dev/gen
	rm -rf "$tmp"
	paso gen generar "$tmp" || return 1
	cp "$tmp/go/lazulv1/lazul.pb.go" proto/go/lazulv1/
	mkdir -p proto/ts/src/lazul/v1
	cp "$tmp/ts/lazul/v1/lazul_pb.ts" proto/ts/src/lazul/v1/
	echo "listo: proto/go/lazulv1 y proto/ts/src"
}

ts_check() {
	(cd proto/ts && { [ -d node_modules ] || npm ci --silent --no-audit --no-fund; } && npx --no-install tsc --noEmit -p . && node --experimental-transform-types --no-warnings --test --test-reporter=dot prueba.test.ts)
}

cmd_check() {
	local fallo=0
	paso formato fmt_check || fallo=1
	paso vet go vet ./... || fallo=1
	paso compilar go build ./... || fallo=1
	paso apps go test ./core/apps -run TestCatalogoIncluido || fallo=1
	paso pruebas go_test ./... || fallo=1
	if hay_protoc && [ "$(go env GOOS)" != windows ]; then
		paso proto proto_al_dia || fallo=1
	else
		echo "omitido proto      (sin protoc o en Windows; en el CI de Linux sí corre)"
	fi
	if command -v node >/dev/null; then
		paso tipos-ts ts_check || fallo=1
	else
		echo "omitido tipos-ts   (falta node)"
	fi
	[ $fallo = 0 ] && echo "check: todo bien" || echo "check: hay fallas"
	return $fallo
}

# tabla_contrato LOG: una línea por regla del contrato, con el motivo si falla.
tabla_contrato() {
	tr -d '\r' <"$1" | awk '
		/^=== RUN/ { t = $3; next }
		/^ +[A-Za-z_]+\.go:[0-9]+: / && t != "" && !(t in msg) { sub(/^ +[A-Za-z_]+\.go:[0-9]+: /, ""); msg[t] = $0 }
		/--- (PASS|FAIL|SKIP): TestContrato(Vivo)?\// {
			s = $2; n = $3; sub(":", "", s); r = n; sub(/^TestContrato\//, "", r); sub(/^TestContratoVivo\//, "en vivo/", r)
			printf "       %-4s %s%s\n", s, r, (s == "FAIL" && n in msg) ? "  <- " msg[n] : ""
		}'
}

# contrato NOMBRE comando...: como paso, pero el resumen es la tabla.
contrato() {
	local nombre=$1; shift
	local log=".dev/$nombre.log" r
	"$@" >"$log" 2>&1; r=$?
	local pasa total
	pasa=$(grep -c -E -- '--- PASS: TestContrato(Vivo)?/' "$log")
	total=$(grep -c -E -- '--- (PASS|FAIL|SKIP): TestContrato(Vivo)?/' "$log")
	if [ $r = 0 ]; then printf 'ok     %-10s %s/%s reglas\n' "$nombre" "$pasa" "$total"
	else printf 'FALLA  %-10s %s/%s reglas (registro: %s)\n' "$nombre" "$pasa" "$total" "$log"; fi
	[ "$total" -gt 0 ] && tabla_contrato "$log" || [ $r = 0 ] || resumen "$log"
	return $r
}

cmd_contrato() {
	local so
	so=$(go env GOOS)
	case $so in
	linux | windows) LAZUL_CONTRATO=1 contrato contrato go test -count=1 -v ./platform/$so/ ;;
	*) echo "sin adaptador para $so"; return 1 ;;
	esac
}

# win: copia el árbol de trabajo (sin prototipos/) al PC Windows y corre ahí.
cmd_win() {
	local que=${1:-test}
	local tgz=.dev/win.tgz
	git ls-files -co --exclude-standard | grep -v -E '^prototipos/|node_modules/' |
		while read -r f; do [ -f "$f" ] && echo "$f"; done | tar -czf "$tgz" -T - || return 1
	scp -q -o LogLevel=ERROR "$tgz" win:lazul-dev.tgz 2>/dev/null || { echo "no pude copiar a win (¿ssh win?)"; return 1; }
	local preparar='$ErrorActionPreference="Stop"; $d="$HOME\lazul-dev"; if (Test-Path $d) { Remove-Item -Recurse -Force $d }; New-Item -ItemType Directory $d | Out-Null; tar -xzf "$HOME\lazul-dev.tgz" -C $d; Set-Location $d;'
	case $que in
	test) paso win-test ssh -o LogLevel=ERROR win "$preparar go vet ./... ; if (\$LASTEXITCODE) { exit 1 }; go test ./... ; exit \$LASTEXITCODE" ;;
	check) paso win-check ssh -o LogLevel=ERROR win "$preparar if (gofmt -l core platform gestures proto desktop) { 'sin gofmt'; exit 1 }; go vet ./... ; if (\$LASTEXITCODE) { exit 1 }; go build ./... ; if (\$LASTEXITCODE) { exit 1 }; go test ./... ; exit \$LASTEXITCODE" ;;
	contrato)
		# El portapapeles, la captura y la ventana activa solo existen en la
		# sesión del escritorio, no en la de ssh: se corre como tarea programada.
		contrato win-contrato ssh -o LogLevel=ERROR win "$preparar go test -c -o contrato.test.exe ./platform/windows/ ; if (\$LASTEXITCODE) { exit 1 }; & .\\herramientas\\win-escritorio.ps1 -exe (Join-Path \$d contrato.test.exe) -argumentos '-test.v -test.count=1' -entorno 'LAZUL_CONTRATO=1;LAZUL_CONTRATO_ABRIR=${LAZUL_CONTRATO_ABRIR:-0}'; exit \$LASTEXITCODE" ;;
	*) echo "uso: ./dev win test|check|contrato"; return 2 ;;
	esac
}

# Los intentos fallidos uno a uno (líneas "  caso · ...") quedan en el registro.
cmd_sim() { paso sim go run ./core/cmd/sim "$@"; local r=$?; grep -v -E '^ok|^  [a-z0-9]+ · ' .dev/sim.log | head -40 | sed 's/^/       /'; return $r; }

cmd_replay() { paso replay go run ./gestures/cmd/replay "$@"; local r=$?; sed 's/^/       /' .dev/replay.log; return $r; }

# grabar no es un paso: queda corriendo hasta Ctrl+C.
cmd_grabar() { go run ./gestures/cmd/grabar "$@"; }

# e2e win|linux [args del controlador]: de punta a punta entre los 2 PCs de
# verdad, con las grabaciones reales de gestos.
#   win    controlador aquí (pantalla y ventana de este Linux), receptor en el
#          escritorio de Windows. El cortafuegos de Windows no deja entrar
#          conexiones nuevas, así que el puerto va por un túnel de ssh.
#   linux  controlador en el escritorio de Windows, receptor aquí en el puerto
#          de LocalSend (53317, el que deja entrar el cortafuegos), directo
#          por la red local.
# Por defecto el receptor no abre nada (solo anota); LAZUL_ABRIR=1 abre de
# verdad. Lo recibido se borra al terminar.
E2E=.dev/e2e
WIN_DIR='$HOME\lazul-e2e'
VENTANAS_WIN='url:https://example.org/,archivo:fixtures/gestos/activar-buena-002.jsonl,app:firefox,real'
VENTANAS_LINUX='url:https://example.org/,archivo:fixtures\gestos\activar-buena-002.jsonl,app:msedge.exe,real'

abrir_bool() { [ "${LAZUL_ABRIR:-0}" = 1 ] && echo true || echo false; }

# esperar_codigo LOG: hasta que el receptor muestre huella y código.
leer_receptor() { HR=$(grep -a -oP 'huella \K[0-9a-f]{64}' "$1" | head -1); COD=$(grep -a -oP 'codigo \K[0-9]{6}' "$1" | head -1); }

e2e_win() {
	local puerto=${LAZUL_PUERTO:-47900}
	GOOS=windows GOARCH=amd64 go build -o $E2E/receptor.exe ./core/cmd/receptor || return 1
	go build -o $E2E/controlador ./core/cmd/controlador || return 1
	local hc
	hc=$($E2E/controlador -solo-huella -estado $E2E/c) || return 1
	ssh -o LogLevel=ERROR win "\$d=\"$WIN_DIR\"; New-Item -Force -ItemType Directory \$d | Out-Null; Get-ChildItem \$d | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue; exit 0" || return 1
	scp -q -o LogLevel=ERROR $E2E/receptor.exe herramientas/win-escritorio.ps1 win:lazul-e2e/ || return 1
	echo "receptor en el escritorio de Windows (127.0.0.1:$puerto, abrir=$(abrir_bool))"
	ssh -o LogLevel=ERROR win "& \"$WIN_DIR\win-escritorio.ps1\" -exe \"$WIN_DIR\receptor.exe\" -argumentos '-escucha 127.0.0.1:$puerto -estado estado -emparejar -permitir $hc -abrir=$(abrir_bool) -duracion 600s' -segundos 620" >$E2E/receptor-fin.log 2>&1 &
	local i
	for i in $(seq 40); do
		sleep 1
		ssh -o LogLevel=ERROR win "[Console]::OutputEncoding=[Text.Encoding]::UTF8; Get-Content -Encoding UTF8 \"$WIN_DIR\escritorio-salida.txt\" -ErrorAction SilentlyContinue" >$E2E/receptor.log 2>/dev/null
		leer_receptor $E2E/receptor.log
		[ -n "$COD" ] && break
	done
	[ -n "$COD" ] || { echo "el receptor de Windows no arrancó (¿sesión de escritorio abierta?)"; cat $E2E/receptor.log; return 1; }
	ssh -o LogLevel=ERROR -o ExitOnForwardFailure=yes -N -L $puerto:127.0.0.1:$puerto win &
	local tunel=$!
	sleep 2
	$E2E/controlador -receptor 127.0.0.1:$puerto -huella "$HR" -codigo "$COD" -estado $E2E/c -nombre "PC Linux" -ventanas "$VENTANAS_WIN" "$@"
	local r=$?
	kill $tunel 2>/dev/null
	ssh -o LogLevel=ERROR win "Get-Process receptor -ErrorAction SilentlyContinue | Stop-Process -Force" >/dev/null 2>&1
	wait
	ssh -o LogLevel=ERROR win "[Console]::OutputEncoding=[Text.Encoding]::UTF8; Get-Content -Encoding UTF8 \"$WIN_DIR\escritorio-salida.txt\"" >$E2E/receptor.log 2>/dev/null
	echo "receptor (Windows): $(grep -a -c ' orden .* ok (aquí' $E2E/receptor.log) órdenes ok, $(grep -a -c 'FALLA' $E2E/receptor.log) fallas (registro: $E2E/receptor.log)"
	ssh -o LogLevel=ERROR win "Remove-Item -Recurse -Force \"$WIN_DIR\estado\recibidos\" -ErrorAction SilentlyContinue" >/dev/null 2>&1
	return $r
}

e2e_linux() {
	local puerto=${LAZUL_PUERTO:-53317} ipwin ipaqui
	ipwin=$(ssh -G win | awk '/^hostname /{print $2}')
	ipaqui=$(ip -4 route get "$ipwin" | grep -oP 'src \K\S+')
	[ -n "$ipaqui" ] || { echo "no sé por qué IP me ve Windows"; return 1; }
	GOOS=windows GOARCH=amd64 go build -o $E2E/controlador.exe ./core/cmd/controlador || return 1
	go build -o $E2E/receptor ./core/cmd/receptor || return 1
	tar -czf $E2E/fixtures.tgz fixtures/gestos || return 1
	ssh -o LogLevel=ERROR win "\$d=\"$WIN_DIR\"; New-Item -Force -ItemType Directory \$d | Out-Null; Get-ChildItem \$d | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue; exit 0" || return 1
	scp -q -o LogLevel=ERROR $E2E/controlador.exe $E2E/fixtures.tgz herramientas/win-escritorio.ps1 win:lazul-e2e/ || return 1
	local hc
	hc=$(ssh -o LogLevel=ERROR win "Set-Location \"$WIN_DIR\"; tar -xzf fixtures.tgz; .\controlador.exe -solo-huella -estado c" | tr -d '\r') || return 1
	rm -rf $E2E/r
	$E2E/receptor -escucha ":$puerto" -estado $E2E/r -emparejar -permitir "$hc" -abrir=$(abrir_bool) -duracion 600s >$E2E/receptor.log 2>&1 &
	local rec=$!
	sleep 1
	leer_receptor $E2E/receptor.log
	[ -n "$COD" ] || { echo "el receptor no arrancó"; cat $E2E/receptor.log; kill $rec; return 1; }
	echo "receptor aquí ($ipaqui:$puerto, abrir=$(abrir_bool)); controlador en el escritorio de Windows"
	local args="-receptor $ipaqui:$puerto -huella $HR -codigo $COD -estado c -nombre PC-Windows -ventanas $VENTANAS_LINUX $*"
	ssh -o LogLevel=ERROR win "& \"$WIN_DIR\win-escritorio.ps1\" -exe \"$WIN_DIR\controlador.exe\" -argumentos '$args' -segundos 900" | tr -d '\r'
	local r=${PIPESTATUS[0]}
	kill $rec 2>/dev/null
	wait $rec 2>/dev/null
	echo "receptor (Linux): $(grep -a -c ' orden .* ok (aquí' $E2E/receptor.log) órdenes ok, $(grep -a -c 'FALLA' $E2E/receptor.log) fallas (registro: $E2E/receptor.log)"
	rm -rf $E2E/r/recibidos
	return $r
}

cmd_e2e() {
	mkdir -p $E2E
	case ${1:-} in
	win) shift; e2e_win "$@" ;;
	linux) shift; e2e_linux "$@" ;;
	*) echo "uso: ./dev e2e win|linux [args del controlador]"; return 2 ;;
	esac
}

# ---------- app de escritorio (desktop/app, módulo aparte: Wails y cgo) ----------
APP=.dev/app
APP_WIN='$HOME\Lazul'
APP_TITULO_PRUEBA='Lazul prueba-agente'

app_assets() { [ -f desktop/app/frontend/vendor/vision_bundle.mjs ] || desktop/app/traer-assets.sh; }
app_linux() { app_assets && (cd desktop/app && go build -tags desktop,production,webkit2_41 -o ../../$APP/lazul .); }
app_windows() { app_assets && (cd desktop/app && GOOS=windows GOARCH=amd64 CGO_ENABLED=0 go build -tags desktop,production -ldflags '-H windowsgui' -o ../../$APP/lazul.exe .); }

# app_copiar_win: deja lazul.exe y los scripts en %USERPROFILE%\Lazul.
app_copiar_win() {
	ssh -o LogLevel=ERROR win "New-Item -Force -ItemType Directory \"$APP_WIN\" | Out-Null; Get-Process lazul -ErrorAction SilentlyContinue | Stop-Process -Force; exit 0" || return 1
	scp -q -o LogLevel=ERROR $APP/lazul.exe herramientas/win-escritorio.ps1 desktop/app/abrir-windows.ps1 win:Lazul/ || { echo "no pude copiar a win (¿ssh win?)"; return 1; }
}

# hypr_prueba: la ventana de prueba de los agentes (clase lazul-prueba: el
# ejecutable se copia con ese nombre) va al espacio 66, en una pantalla
# virtual lejos de las reales, sin foco: no molesta al dueño y sí recibe
# fotogramas (en un espacio oculto la página se para). hypr_fin la quita.
hypr_prueba() {
	command -v hyprctl >/dev/null || return 0
	cp $APP/lazul $APP/lazul-prueba
	hyprctl eval 'hl.workspace_rule({ workspace = "66", monitor = "LAZULPRUEBA", default = true })' >/dev/null
	hyprctl eval 'hl.window_rule({ match = { class = "lazul-prueba" }, workspace = "66 silent", no_initial_focus = true, focus_on_activate = false })' >/dev/null
	if ! hyprctl monitors | grep -q "^Monitor LAZULPRUEBA"; then
		hyprctl output create headless LAZULPRUEBA >/dev/null
		sleep 1
		hyprctl eval 'hl.monitor({ output = "LAZULPRUEBA", mode = "1280x800@60", position = "-9000x-9000", scale = 1 })' >/dev/null
	fi
}
hypr_fin() { command -v hyprctl >/dev/null && hyprctl output remove LAZULPRUEBA >/dev/null 2>&1; return 0; }

# app_e2e win|linux: la app de verdad en los 2 PCs, sin cámara: el
# controlador pasa grabaciones reales (activar, agarrar, soltar) por el mismo
# camino que la cámara y la captura de su pantalla tiene que llegar al otro.
#   win    controla este Linux, recibe Windows (directo al puerto 53317)
#   linux  controla Windows, recibe este Linux
APP_RECORRIDO=activar-buena-002,agarrar-buena-003,soltar-buena-003
app_e2e() {
	local sentido=${1:-win} ipwin ipaqui r=0
	ipwin=$(ssh -G win | awk '/^hostname /{print $2}')
	ipaqui=$(ip -4 route get "$ipwin" | grep -oP 'src \K\S+')
	paso app-linux app_linux || return 1
	paso app-windows app_windows || return 1
	app_copiar_win || return 1
	local d=$APP/e2e; rm -rf $d; mkdir -p $d
	hypr_prueba
	case $sentido in
	win)
		local hc
		hc=$($APP/lazul -solo-huella -estado $d/linux) || return 1
		ssh -o LogLevel=ERROR win "\$d=\"$APP_WIN\\e2e\"; if (Test-Path \$d) { Remove-Item -Recurse -Force \$d }; exit 0"
		ssh -o LogLevel=ERROR win "& \"$APP_WIN\\win-escritorio.ps1\" -exe \"$APP_WIN\\lazul.exe\" -argumentos '-estado e2e -camara no -mdns=false -mostrar-codigo -permitir $hc -abrir=false -duracion 60s -titulo \"$APP_TITULO_PRUEBA\" -salida e2e-salida.txt' -segundos 80" >$d/win-fin.log 2>&1 &
		local i
		for i in $(seq 40); do
			sleep 1
			ssh -o LogLevel=ERROR win "[Console]::OutputEncoding=[Text.Encoding]::UTF8; Get-Content -Encoding UTF8 \"$APP_WIN\\e2e-salida.txt\" -ErrorAction SilentlyContinue" >$d/win.log 2>/dev/null
			leer_receptor $d/win.log
			[ -n "$COD" ] && break
		done
		[ -n "$COD" ] || { echo "la app de Windows no arrancó (¿sesión de escritorio abierta?)"; cat $d/win.log; return 1; }
		echo "receptor: la app en Windows ($ipwin:53317, código en pantalla); controlador: la app aquí con $APP_RECORRIDO"
		$APP/lazul-prueba -estado $d/linux -camara no -mdns=false -escucha 127.0.0.1:0 -reproducir $APP_RECORRIDO -emparejar-con "$ipwin:53317" -codigo "$COD" \
			-duracion 25s -eco -titulo "$APP_TITULO_PRUEBA" >$d/linux.log 2>&1
		wait
		ssh -o LogLevel=ERROR win "[Console]::OutputEncoding=[Text.Encoding]::UTF8; Get-Content -Encoding UTF8 \"$APP_WIN\\e2e-salida.txt\"" >$d/win.log 2>/dev/null
		ssh -o LogLevel=ERROR win "Set-Location \"$APP_WIN\"; Remove-Item -Recurse -Force e2e, e2e-salida.txt, escritorio-salida.txt, escritorio-codigo.txt, escritorio.cmd -ErrorAction SilentlyContinue" >/dev/null 2>&1
		;;
	linux)
		tar -czf $d/fixtures.tgz fixtures/gestos || return 1
		scp -q -o LogLevel=ERROR $d/fixtures.tgz win:Lazul/ || return 1
		local hc
		hc=$(ssh -o LogLevel=ERROR win "Set-Location \"$APP_WIN\"; if (Test-Path e2e) { Remove-Item -Recurse -Force e2e }; Remove-Item huella.txt -ErrorAction SilentlyContinue; tar -xzf fixtures.tgz; .\\lazul.exe -solo-huella -estado e2e -salida huella.txt | Out-Null; Get-Content huella.txt" | tr -d '\r') || return 1
		$APP/lazul-prueba -estado $d/linux -camara no -mdns=false -mostrar-codigo -permitir "$hc" -abrir=false -duracion 60s -titulo "$APP_TITULO_PRUEBA" >$d/linux.log 2>&1 &
		local rec=$!
		sleep 2
		leer_receptor $d/linux.log
		[ -n "$COD" ] || { echo "la app de Linux no arrancó"; cat $d/linux.log; kill $rec; return 1; }
		echo "receptor: la app aquí ($ipaqui:53317); controlador: la app en Windows con $APP_RECORRIDO"
		ssh -o LogLevel=ERROR win "& \"$APP_WIN\\win-escritorio.ps1\" -exe \"$APP_WIN\\lazul.exe\" -argumentos '-estado e2e -camara no -mdns=false -escucha 127.0.0.1:0 -reproducir $APP_RECORRIDO -emparejar-con $ipaqui:53317 -codigo $COD -duracion 25s -eco -titulo \"$APP_TITULO_PRUEBA\" -salida e2e-salida.txt' -segundos 60" >/dev/null 2>&1
		ssh -o LogLevel=ERROR win "[Console]::OutputEncoding=[Text.Encoding]::UTF8; Get-Content -Encoding UTF8 \"$APP_WIN\\e2e-salida.txt\"" | tr -d '\r' >$d/win.log 2>/dev/null
		kill $rec 2>/dev/null; wait $rec 2>/dev/null
		ssh -o LogLevel=ERROR win "Set-Location \"$APP_WIN\"; Remove-Item -Recurse -Force e2e, fixtures, fixtures.tgz, huella.txt, e2e-salida.txt, escritorio-salida.txt, escritorio-codigo.txt, escritorio.cmd -ErrorAction SilentlyContinue" >/dev/null 2>&1
		;;
	*) echo "uso: ./dev app e2e win|linux"; return 2 ;;
	esac
	local ctl=$d/linux.log rcp=$d/win.log
	[ "$sentido" = linux ] && { ctl=$d/win.log; rcp=$d/linux.log; }
	grep -a -E 'emparejado|gesto |"tipo":"accion"|"tipo":"activacion"' "$ctl" | sed 's/^/       ctl  /'
	grep -a -E 'permiso|abriría|FALLA' "$rcp" | sed 's/^/       rcp  /'
	if grep -a -q '"gesto":"SOLTAR".*"resultado":"ok"' "$ctl" && grep -a -q 'abriría el archivo recibido (.png' "$rcp"; then
		echo "ok     app-e2e    la captura agarrada con la app en un PC llegó a la app del otro (registros: $d)"
	else
		echo "FALLA  app-e2e    (registros: $ctl, $rcp)"; r=1
	fi
	rm -rf $d/linux/recibidos
	return $r
}

cmd_app() {
	case ${1:-} in
	compilar) paso app-linux app_linux && paso app-windows app_windows ;;
	resumen) shift; go run ./desktop/cmd/resumen "$@" ;;
	e2e) shift; app_e2e "$@"; local r=$?; hypr_fin; return $r ;;
	win)
		shift
		paso app-windows app_windows || return 1
		app_copiar_win || return 1
		local args="$*"
		ssh -o LogLevel=ERROR win "& \"$APP_WIN\\abrir-windows.ps1\" -argumentos '$args'" || return 1
		echo "abierta en el escritorio de Windows: %USERPROFILE%\\Lazul\\lazul.exe (doble clic para volver a abrirla)"
		;;
	*)
		paso app-linux app_linux || return 1
		exec $APP/lazul "$@"
		;;
	esac
}

uso() { sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; }

orden=${1:-}
[ $# -gt 0 ] && shift
case $orden in
check) cmd_check ;;
test) paso test go_test "${@:-./...}" && tail -1 .dev/test.log | sed 's/^/       /' ;;
contrato) cmd_contrato ;;
sim) cmd_sim "$@" ;;
replay) cmd_replay "$@" ;;
grabar) cmd_grabar "$@" ;;
gen) cmd_gen ;;
win) cmd_win "$@" ;;
e2e) cmd_e2e "$@" ;;
app) cmd_app "$@" ;;
*) uso; [ -z "$orden" ] || [ "$orden" = ayuda ] || exit 2 ;;
esac
